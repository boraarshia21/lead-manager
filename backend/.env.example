PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lead-manager
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Deployed frontend origin(s), comma-separated, e.g. https://lead-manager.vercel.app
CLIENT_URL=
